# HTTPS in front of Kuri. DOMAIN comes from .env (e.g. kuri.hackgenix.com).
# Caddy gets and renews the Let's Encrypt certificate by itself; the domain's DNS must
# point at this server and ports 80 + 443 must be open.
{$DOMAIN} {
	encode zstd gzip
	# Readings upload 4 images (face, palm, enhanced palm, 300-dpi card).
	request_body {
		max_size 30MB
	}
	reverse_proxy app:5010
}
