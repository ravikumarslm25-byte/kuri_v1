PORT=5010
MONGO_URI=mongodb://127.0.0.1:27017/kuri

# Shared secret entered once on each kiosk's setup screen to register it.
KIOSK_PROVISION_KEY=change-me-long-random-string

# Comma-separated origins allowed to call the API (kiosk + admin). * = any (dev only).
CORS_ORIGINS=*

UPLOAD_DIR=uploads

# Gemini (fortune generation). Leave empty to run on offline fallback fortunes only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=9000

# Admin panel
ADMIN_JWT_SECRET=change-me-64-random-chars
ADMIN_JWT_TTL=12h
# First super admin (used by `npm run create-admin`)
ADMIN_EMAIL=ravi@hackgenix.com
ADMIN_PASSWORD=

# Guest photos/contacts are erased after N days (readings kept for reports). 0 = never.
DATA_RETENTION_DAYS=90
TIME_ZONE=Asia/Kolkata
